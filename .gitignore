.next/
node_modules/
out/
.env
.env.local
.env.production.local

# Headless-Chrome user-data dirs left behind by layout/playback verification runs
.chrome-*/
.*-chrome*/

# Throwaway verification screenshots. Real images live in pic/ or public/,
# never at the repo root.
/*.png

# Master PNGs for the Alcohol Directory flipbook (110 MB). The deployed book
# reads the WebP copies in public/alcohol/book/pages/ -- these are the originals
# to re-export from, and they must stay out of public/ so they are not shipped.
/alcohol-book-source/

# Raw desktop recordings for the Cleared case study (55 MB). The page plays the
# cropped loops in public/cleared/media/; these are the originals that
# scripts/cleared-desktop-media-build.cjs re-exports from.
/public/cleared/video1.mp4
/public/cleared/video2.mp4

# Design-file exports for the BUBU case study. The two folders are the
# simulator captures (28 MB, one per language) that
# scripts/bubu-media-build.cjs re-exports nine of into
# public/bubu/screens/<locale>/. Frame 1-6 are composed boards of the same
# screens, kept beside them but not shown on the page.
/public/bubu/English/
/public/bubu/中文/
/public/bubu/Frame *.png
